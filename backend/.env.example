# Backend environment variables
# Copy this file to .env and fill in real values

SERVER_PORT=8080

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=jobuser
DB_PASSWORD=changeme
DB_NAME=jobtracker
# Set to "disable" only for local Postgres without TLS
DB_SSLMODE=require

# MCP server
MCP_SERVER_URL=http://localhost:9423

# JWT — generate with: openssl rand -hex 32
JWT_SECRET=changeme

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173

# OAuth sign-in. A provider's button works only when its client ID is set.
# Register these callback URLs with the provider (they must match exactly):
#   <PUBLIC_BASE_URL>/api/auth/google/callback
#   <PUBLIC_BASE_URL>/api/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Where the browser reaches this API, and where it lands after sign-in.
# `mise run dev` sets both for local dev.
PUBLIC_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173
# Comma-separated accounts allowed to sign in
ALLOWED_EMAILS=you@example.com
